<odoo>
    <data noupdate="1">
        <record id="ir_cron_license_notification" model="ir.cron">
            <field name="name">Notificare licenta</field>
            <field name="model_id" ref="model_notification_client"/>
            <field name="state">code</field>
            <field name="code">model.start_notification_loop()</field>
            <field name='interval_number'>1</field>
            <field name='interval_type'>minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>