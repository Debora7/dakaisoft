<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="account_invoice_form" model="ir.ui.view">
    	<field name="name">Account Invoice Supplier Inherit</field>
    	<field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority" eval="60"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_set_checked']" position="after">
            	<field name="move_type" invisible="1"/>
                <field name="state" invisible="1"/>
            	<field name="purchase_order_count" invisible="1"/>
            	<button type="object" class="oe_highlight" name="createPo" string="Create RFQ" invisible="move_type != 'in_invoice' or purchase_order_count > 0 or state != 'posted'"/>
            </xpath>
        </field>
    </record>
</odoo>
