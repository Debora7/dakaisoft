<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_edi_document_inherit" model="ir.ui.view">
        <field name="name">Account Edi Document Inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account_edi.view_move_form_inherit"/>
        <field name="priority" eval="60"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='edi_document_ids']//tree" position="inside">
                <field name="state" invisible="1"/>
                <button name="l10n_ro_set_bloching_level_error" type="object" class="oe_link oe_inline" string="Schedule Resend" groups="base.group_no_one" attrs="{'invisible': [('state', 'in', ['cancel','sent'])]}"/>
            </xpath>
        </field>
    </record>

</odoo>
