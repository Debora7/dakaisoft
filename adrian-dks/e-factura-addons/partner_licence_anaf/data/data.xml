<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <record id="cron_refresh_anaf_auth_token" model="ir.cron">
            <field name="name">Refresh anaf token</field>
            <field name="model_id" ref="partner_licence.model_res_partner_licence" />
            <field name="state">code</field>
            <field name="code">model.cronRefreshTokens()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(datetime.utcnow() + timedelta(days=1)).strftime('%Y-%m-%d 04:00:00')" />
            <!-- it s every day -->
            <!-- <field name="numbercall">-1</field> -->
            <!-- <field name="doall" eval="False" /> -->
        </record>
    </data>
</odoo>
