<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <template id="e_transport_picking_from_batch" inherit_id="l10n_ro_etransport.e_transport">
        <xpath expr="//{mfp:anaf:dgti:eTransport:declaratie:v2}dateTransport" position="replace">
          <t t-set="carrier" t-value="doc.carrier_id.l10n_ro_e_partner_id"/>
          <dateTransport
              t-att-nrVehicul="(doc.l10n_ro_vehicle and doc.l10n_ro_vehicle or '').upper().replace('-', '')"
              t-att-codOrgTransport="(carrier.vat or '').upper().replace('RO', '')"
              t-att-codTaraOrgTransport="get_country_code(carrier.country_id.code)"
              t-att-denumireOrgTransport="carrier.name"
              t-att-dataTransport="doc.scheduled_date.date()"
              t-att-nrRemorca1="(doc.l10n_ro_remorca1 or '00').upper().replace('-', '')"
              t-att-nrRemorca2="(doc.l10n_ro_remorca2 or '00').upper().replace('-', '')"
              />
        </xpath>
        <xpath expr="//{mfp:anaf:dgti:eTransport:declaratie:v2}documenteTransport" position="replace">
          <documenteTransport
              t-att-tipDocument="doc.l10n_ro_doc_type"
              t-att-numarDocument="doc.l10n_ro_doc_type_nr"
              t-att-dataDocument="doc.l10n_ro_doc_type_date"/>
        </xpath>
    </template>
</odoo>
