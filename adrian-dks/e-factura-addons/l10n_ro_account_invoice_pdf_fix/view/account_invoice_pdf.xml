<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<template id="account_invoice_document" inherit_id="account.report_invoice_document" priority="17">
		<xpath expr="//table[@name='invoice_line_table']//th[@name='th_taxes']" position="attributes">
			<attribute name="t-attf-class">text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}</attribute>
		</xpath>
		<xpath expr="//table[@name='invoice_line_table']//th[@name='th_subtotal']" position="attributes">
			<attribute name="t-attf-class">text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}</attribute>
		</xpath>
		<xpath expr="//span[@id='line_tax_ids']" position="replace">
			<t t-set="sign" t-value="1 if line.price_subtotal &gt; 0 else -1"/>
			<span t-esc="((line.price_total - line.price_subtotal) * sign)" id="line_tax_ids" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
		</xpath>
		<xpath expr="//span[@id='line_tax_ids']/parent::td" position="attributes">
			<attribute name="t-attf-class">text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}</attribute>
		</xpath>
		<xpath expr="//t[@name='account_invoice_line_accountable']//td[2]/span[1]" position="replace">
			<span t-if="line.price_subtotal &lt; 0 ">-</span>
			<span t-field="line.quantity"/>
		</xpath>
		<xpath expr="//t[@name='account_invoice_line_accountable']//td[hasclass('o_price_total')]/span[2]" position="replace">
			<span t-if="line.price_subtotal &lt; 0 " groups="account.group_show_line_subtotals_tax_included">-</span>
			<span t-field="line.price_total" groups="account.group_show_line_subtotals_tax_included"/>
		</xpath>
		<xpath expr="//t[@name='account_invoice_line_accountable']//td[hasclass('o_price_total')]/span[1]" position="replace">
			<span t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
		</xpath>
		<xpath expr="//tbody[hasclass('invoice_tbody')]/t[3]/t[1]" position="replace">
			<t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
		</xpath>
		<xpath expr="//tbody[hasclass('invoice_tbody')]/t[3]/t[2]" position="replace">
			<t t-set="sign" t-value="1 if line.balance &gt; 0 else -1"/>
			<t t-set="current_subtotal" t-value="current_subtotal + (line.price_total * sign)" groups="account.group_show_line_subtotals_tax_included"/>
		</xpath>
