<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_l10n_ro_edi_custom_form" model="ir.ui.view">
        <field name="name">l10n.ro.edi.custom.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_ro_edi.res_config_settings_form_inherit_l10n_ro_edi" />
        <field name="type">form</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_ro_edi_client_id']/.." position="replace"/>
                <xpath expr="//field[@name='l10n_ro_edi_client_secret']/.." position="replace"/>
            <xpath expr="//button[@name='button_l10n_ro_edi_generate_token']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='l10n_ro_edi_access_token']" position="attributes">
                    <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='l10n_ro_edi_refresh_token']" position="attributes">
                    <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='l10n_ro_edi_access_expiry_date']" position="attributes">
                    <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='l10n_ro_edi_access_token']/.." position="before">
                <div class="row">
                <label for="provider_id" class="col-lg-3 o_light_label"/>
                <field name="provider_id" options="{'no_quick_create': True, 'no_create_edit' : True}"/>
                </div>
                <div class="row">
                <label for="provider_licence" class="col-lg-3 o_light_label"/>
                <field name="provider_licence" readonly="1"/>
                </div>
                <div class="row">
                    <label for="licence_status" class="col-lg-3 o_light_label"/>
                    <field name="licence_status" statusbar_visible="draft,waiting_licence,confirmed_licence,confirmed_token" readonly="1"/>
                </div>
                <div class="row">
                    <label for="err_message" class="col-lg-3 o_light_label" invisible="1"/>
                    <field name="err_message" class="oe_inline" invisible="1"/>
                </div>
            </xpath>
            <xpath expr="//button[@name='button_l10n_ro_edi_generate_token']" position="after">
                <button name="get_anaf_licence" type="object" class="btn btn-primary" invisible="licence_status != 'draft'" string="Get ANAF Licence"/>
            </xpath>
            <xpath expr="//button[@name='get_anaf_licence']" position="after">
                <button name="button_l10n_ro_edi_generate_token_auth" type="object" class="btn btn-primary" invisible="l10n_ro_edi_access_token not in ['', False] or licence_status != 'confirmed_licence'" string="Generate Token"/>
            </xpath>
        </field>
    </record>

    <record id="l10n_ro_account_anaf_sync_provider_form" model="ir.ui.view">
        <field name="name">l10n.ro.account.anaf.sync.provider Form</field>
        <field name="model">l10n.ro.account.anaf.sync.provider</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="name" />
                    </group>
                    <group>
                        <field name="url" />
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id="l10n_ro_account_anaf_sync_provider_tree" model="ir.ui.view">
        <field name="name">l10n.ro.account.anaf.sync.provider Tree</field>
        <field name="model">l10n.ro.account.anaf.sync.provider</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="url" />
            </list>
        </field>
    </record>


    <record id="l10n_ro_account_anaf_sync_provider_action" model="ir.actions.act_window">
        <field name="name">Partner Anaf Provider</field>
        <field name="res_model">l10n.ro.account.anaf.sync.provider</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
    id="menu_l10n_ro_account_anaf_sync_provider"
    parent="account.account_account_menu"
    name="Configurare Furnizor Anaf"
    sequence="100"
    action="l10n_ro_account_anaf_sync_provider_action"
    groups="account.group_account_manager"
  />

</odoo>
