<odoo>

    <record id="view_partner_create_client_tree" model="ir.ui.view">
        <field name="name">Partner Create Client</field>
        <field name="model">partner.create.client</field>
        <field name="type">tree</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="endpoint"/>
            </tree>
        </field>
    </record>

    <record id="view_partner_create_client_form" model="ir.ui.view">
        <field name="name">Partner Create Client</field>
        <field name="model">partner.create.client</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="endpoint"/>
                            <field name="licence"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="partner_create_client_action" model="ir.actions.act_window">
        <field name="name">Partner Create Client</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">partner.create.client</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_partner_create_client_tree"/>
    </record>

    <menuitem name="Create Partner API Config"
          id="partner_create_client_menu"
          sequence="25"
          parent="contacts.res_partner_menu_config"
          action="partner_create_client_action"/>

</odoo>