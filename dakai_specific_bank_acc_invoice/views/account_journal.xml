<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
        <record id="account_journal_form" model="ir.ui.view">
                <field name="name">account.journal Form</field>
                <field name="model">account.journal</field>
                <field name="type">form</field> 
                <field name="inherit_id" ref="account.view_account_journal_form"/>
                <field name="arch" type="xml">
                    <xpath expr="//field[@name='restrict_mode_hash_table']" position="after">
                        <field name="company_bank_ids" invisible="1"/>
                        <field name="permited_bank_ids" widget="many2many_tags" domain="[('id','in',company_bank_ids)]"/>
                    </xpath>
                </field>
        </record>

</odoo>
        
