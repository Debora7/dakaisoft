<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="ir_cron_licentiere" model="ir.cron">
        <field name="name">Verificare Licente Server Fiscal</field>
        <field name="model_id" ref="model_res_partner_licence"/>
        <field name="state">code</field>
        <field name="code">model.cron_check_licences()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!-- <field name="numbercall">-1</field> -->
    </record>

    <record id="ir_cron_notify_licence_expiry" model="ir.cron">
        <field name="name">Notify Licence Expiry</field>
        <field name="model_id" ref="model_res_partner_licence"/>
        <field name="state">code</field>
        <field name="code">model.cron_notify_licence_expiry()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!-- <field name="numbercall">-1</field> -->
    </record>

    <record id="email_template_licence_expiry" model="mail.template">
        <field name="name">Licence Expiry Notification</field>
        <field name="model_id" ref="model_res_partner_licence"/>
        <field name="subject">Your Client Licence is About to Expire</field>
        <field name="email_to">${ctx.get('email_to')}</field>
        <field name="body_html">
          <![CDATA[
            <p>Hello,</p>
            <p>The licence for partner <b>${object.partner_id.name}</b> (<a href="mailto:${object.partner_id.email}">${object.partner_id.email}</a>) with hardware key <b>${object.hw_key}</b> will expire on <b>${object.expiration_date}</b>.</p>
            <p>Please review if renewal is needed.</p>
          ]]>
        </field>
    </record>

    <record id="view_res_partner_licence_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.licence.form.inherit</field>
        <field name="model">res.partner.licence</field>
        <field name="inherit_id" ref="partner_licence.res_partner_licence_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="expiration_date"/>
                <field name="hw_key"/>
            </xpath>
        </field>
    </record>

</odoo>